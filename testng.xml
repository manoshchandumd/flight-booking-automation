<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Flight Booking Regression Suite" parallel="methods" thread-count="2">
    <listeners>
        <listener class-name="com.manosh.automation.listeners.TestListener"/>
    </listeners>
    <test name="Search and Booking">
        <classes>
            <class name="com.manosh.automation.tests.FlightSearchTest"/>
            <class name="com.manosh.automation.tests.FlightBookingTest"/>
        </classes>
    </test>
</suite>
